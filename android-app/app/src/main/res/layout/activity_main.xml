<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/godot_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Transparent overlay that exposes Godot's 3D scene to TalkBack as a
        tree of virtual views (app → floor → room → devices). Touch events
        pass through to the Godot fragment underneath; only accessibility
        events stop here. See AccessibilityOverlayView.kt.
    -->
    <com.smartthings.shaderhome.accessibility.AccessibilityOverlayView
        android:id="@+id/accessibility_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/accessibility_overlay_label" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/top_controls_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/side_controls_compose_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="184dp"
        android:layout_marginEnd="16dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bottom_controls_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
